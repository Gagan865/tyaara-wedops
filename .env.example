# Copy to `.env.local` and fill in. Never commit the filled-in file.

# ---- Supabase (required) ----
# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe to expose to the browser; RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER ONLY — bypasses RLS entirely.
# Never prefix this with NEXT_PUBLIC_ or reference it in a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---- WhatsApp inbound webhook (required in production) ----
# Shared secret the provider must send as the `x-webhook-secret` header when
# POSTing to /api/whatsapp/reply. Without it, that route only accepts
# authenticated in-app calls. Generate with: openssl rand -hex 32
WHATSAPP_WEBHOOK_SECRET=

# ---- Email (optional — enables "Send by email" for client share links) ----
# Resend API key. Create a free account at https://resend.com, add an API key here.
# Without it, WhatsApp + Copy-link still work; only email sending is disabled.
RESEND_API_KEY=
# The From address emails are sent as. For real sending, verify your domain in Resend
# and use it (e.g. "Tyaara Weddings <no-reply@prisim.co.in>"). Defaults to Resend's
# test sender, which can only deliver to your own account email.
EMAIL_FROM=

# ---- Optional ----
# Comma-separated origins allowed to call /api/* cross-origin. Leave unset to
# disable CORS entirely (the right default for a cookie-authenticated app).
# CORS_ORIGINS=https://app.example.com

# CSP frame-ancestors value. Defaults to 'self'. Only widen this if you
# intentionally embed WedOps in another site.
# FRAME_ANCESTORS='self' https://partner.example.com
